@page
@model BellBeast.Pages.CHEM_reportModel
@{
    ViewData["Title"] = "CHEM Receive Report";
    ViewData["ContentClass"] = "content content-wide"; // ปลด max-width 1280px ของ .content → เต็มจอ
}

<style>
    /* ===== Force layout full width (กันโดน bootstrap/container จัดกลาง) ===== */
    .container,
    .container-sm,
    .container-md,
    .container-lg,
    .container-xl,
    .container-xxl {
        max-width: 100% !important;
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    /* ✅ สำคัญ: กัน wrapper ถูก max-width/margin auto จาก css กลาง */
    .bb-wrap {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 16px 10%; /* เว้นขอบจอซ้าย-ขวาฝั่งละ 10% */
    }

    /* แถว 1: กล่องค้นหา (ซ้าย) | banner (ขวา, สูงเท่ากล่อง)  ·  แถว 2: Result เต็มความกว้าง */
    .bb-grid {
        width: 100%;
        display: grid;
        grid-template-columns: 264px minmax(0, 1fr); /* 240px × 1.1 */
        gap: 14px;
        align-items: stretch;
    }

    .bb-grid > .bb-result {
        grid-column: 1 / -1;
    }

    /* banner ไม่กำหนดความสูงแถวเอง → แถวสูงตามกล่องค้นหา แล้วภาพ crop ให้เต็มกรอบ */
    .bb-grid > .bb-filter {
        grid-column: 1;
        grid-row: 1;
    }

    .bb-grid > .bb-banner {
        grid-column: 2;
        grid-row: 1;
        position: relative;
        margin-bottom: 0;
    }

        .bb-grid > .bb-banner img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: left center;
        }

    /* จอเล็กให้เรียงลง */
    @@media (max-width: 900px) {
        .bb-wrap {
            padding: 16px;
        }

        .bb-grid {
            grid-template-columns: 1fr;
        }

        .bb-grid > .bb-filter,
        .bb-grid > .bb-banner {
            grid-column: auto;
            grid-row: auto;
        }

        .bb-grid > .bb-banner {
            aspect-ratio: 16 / 5;
        }
    }

    .bb-card {
        background: rgba(20, 25, 35, .72);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: 14px;
        overflow: hidden; /* กันล้น */
    }

    .bb-title {
        font-size: 18px;
        font-weight: 700;
        color: #e8eefc;
        margin: 0 0 10px 0;
    }

    .bb-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .bb-field label {
        display: block;
        font-size: 12px;
        color: rgba(232,238,252,.8);
        margin-bottom: 6px;
    }

    .bb-field input, .bb-field select {
        width: 100%;
        padding: 9px 10px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(0,0,0,.25);
        color: #e8eefc;
        outline: none;
    }

        /* จำกัดเฉพาะ input date ใน bb-field เท่านั้น */
    .bb-field input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(1) brightness(1.4);
        opacity: 0.85;
        cursor: pointer;
    }


    /* วันที่: แสดง d-MMM-yyyy (12-Oct-2026) ในช่องข้อความ, ปฏิทินใช้ native date input ที่ซ่อนไว้ */
    .bb-date {
        position: relative;
    }

        .bb-date input[type="text"] {
            cursor: pointer;
            padding-right: 32px;
        }

        .bb-date::after {
            content: "📅";
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 13px;
            opacity: .8;
            pointer-events: none;
        }

    .bb-date-native {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 0;
        padding: 0 !important;
        border: 0 !important;
        opacity: 0;
        pointer-events: none;
    }

    .bb-actions {
        display: flex;
        gap: 10px;
        margin-top: 6px;
    }

    .bb-btn {
        padding: 9px 12px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(80, 110, 255, .18);
        color: #e8eefc;
        cursor: pointer;
    }

        .bb-btn:hover {
            background: rgba(80,110,255,.28);
        }

        .bb-btn.secondary {
            background: rgba(255,255,255,.08);
        }

            .bb-btn.secondary:hover {
                background: rgba(255,255,255,.12);
            }

    .bb-status {
        margin-top: 10px;
        font-size: 12px;
        color: rgba(232,238,252,.75);
        white-space: pre-wrap;
    }

    /* ===== RESULT HEADER ===== */
    .bb-result-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .bb-banner {
        width: 100%;
        margin-bottom: 12px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.10);
        background: rgba(0,0,0,.18);
    }

    .bb-banner img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: cover;
    }

    .bb-result-total {
        font-size: 13px;
        font-weight: 600;
        color: #e8eefc;
        opacity: .9;
        white-space: nowrap;
    }

    /* ===== SUMMARY CHIPS (ยอดตามฝั่งถัง AB / CD) ===== */
    .bb-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    .bb-chip {
        padding: 6px 10px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(255,255,255,.05);
        font-size: 12px;
        color: #e8eefc;
        white-space: nowrap;
    }

        .bb-chip b {
            font-size: 13px;
        }

        .bb-chip.ab {
            border-color: rgba(80,160,255,.45);
            background: rgba(80,160,255,.12);
        }

        .bb-chip.cd {
            border-color: rgba(255,170,60,.45);
            background: rgba(255,170,60,.12);
        }

    /* ===== TABLE: เต็มความกว้าง, คอลัมน์เยอะจึงเลื่อนแนวนอนได้ ===== */
    .bb-table-wrap {
        width: 100%;
        overflow-x: hidden; /* ไม่มี scroll แนวนอน — คอลัมน์ย่อ/ตัดคำแทน */
        overflow-y: auto;
        max-height: calc(100vh - 230px);
    }

    table.bb-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed; /* บังคับไม่ให้ตารางดันกว้าง */
    }

    /* หัวตารางตัดบรรทัดได้ (จอแคบ) */
    .bb-table th {
        white-space: normal !important;
        overflow-wrap: normal !important; /* ตัดที่ช่องว่างเท่านั้น ไม่หักกลางคำ */
        line-height: 1.25;
        vertical-align: bottom !important;
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .bb-sub {
        display: block;
        font-size: 11px;
        color: rgba(232,238,252,.5);
    }

    /* แถวต่อ (รถคันเดียวเติมถังที่ 2+) */
    .bb-table tr.cont td {
        border-top: none;
    }

    .bb-table tr.trip-start td {
        border-top: 1px solid rgba(255,255,255,.14);
    }

    .bb-tank {
        display: inline-block;
        min-width: 22px;
        padding: 1px 6px;
        border-radius: 6px;
        text-align: center;
        font-weight: 700;
    }

        .bb-tank.ab {
            background: rgba(80,160,255,.22);
        }

        .bb-tank.cd {
            background: rgba(255,170,60,.22);
        }

    .bb-muted {
        color: rgba(232,238,252,.45);
    }

    .bb-table th, .bb-table td {
        border-bottom: 1px solid rgba(255,255,255,.08);
        padding: 7px 6px;
        font-size: 12px;
        color: #e8eefc;
        text-align: left;
        /* แสดงข้อมูลครบ: ตัดบรรทัดแทนการตัด ... (จอแคบแถวจะสูงขึ้นแทน) */
        white-space: normal;
        overflow-wrap: anywhere;
        vertical-align: top;
    }

        .bb-table td.num {
            white-space: nowrap;
            overflow-wrap: normal;
        }

        /* ระดับ "8.6 → 19.6" ตัดบรรทัดได้ที่ช่องว่างรอบลูกศรเท่านั้น */
        .bb-table td.lv {
            white-space: normal;
        }

    .bb-table th {
        position: sticky;
        top: 0;
        background: rgba(20, 25, 35, .92);
        z-index: 2;
    }

        .bb-table td.num, .bb-table th.num {
            text-align: right;
        }

        .bb-table td.center, .bb-table th.center {
            text-align: center;
        }

    /* ✅ สัดส่วนคอลัมน์รวม ~100% */
    /* 14 คอลัมน์: วันที่+เวลา / บริษัท+สินค้า / ระดับก่อน→หลัง รวมช่องเพื่อไม่ต้อง scroll แนวนอน */
    col.c-no {width: 4%;}
    col.c-date {width: 9.5%;}
    col.c-truck {width: 8.5%;}
    col.c-comp {width: 13%;}
    col.c-sg {width: 5%;}
    col.c-temp {width: 5%;}
    col.c-vol {width: 5.5%;}
    col.c-tank {width: 5.5%;}
    col.c-lv {width: 10%;}
    col.c-in {width: 6.5%;}
    col.c-out {width: 6.5%;}
    col.c-net {width: 6.5%;}
    col.c-alloc {width: 7%;}
    col.c-bill {width: 7.5%;}

    /* ===== ขยายตัวอักษร 1.1 เท่า: กล่อง CHEM Receive Report + Result ===== */
    .bb-filter .bb-title {
        font-size: 20px;
    }

    .bb-filter .bb-field label {
        font-size: 13px;
    }

    .bb-filter .bb-field input,
    .bb-filter .bb-field select {
        font-size: 15px;
        padding: 10px 11px;
    }

    .bb-filter .bb-date input[type="text"] {
        padding-right: 34px;
    }

    .bb-filter .bb-date::after {
        font-size: 14px;
    }

    .bb-filter .bb-btn {
        font-size: 15px;
        padding: 10px 13px;
    }

    .bb-filter .bb-status {
        font-size: 13px;
    }

    .bb-result .bb-title {
        font-size: 20px;
    }

    .bb-result .bb-result-total {
        font-size: 14px;
    }

    .bb-result .bb-summary {
        gap: 10px;
        margin-bottom: 12px;
    }

    .bb-result .bb-chip {
        font-size: 13px;
        padding: 7px 11px;
        border-radius: 12px;
    }

        .bb-result .bb-chip b {
            font-size: 14px;
        }

    .bb-result .bb-table th,
    .bb-result .bb-table td {
        font-size: 13px;
        padding: 8px 7px;
    }

    .bb-result .bb-table th {
        padding-left: 6px !important;
        padding-right: 6px !important;
    }

    .bb-result .bb-sub {
        font-size: 12px;
    }

    .bb-result .bb-tank {
        min-width: 24px;
        padding: 1px 7px;
        border-radius: 8px;
    }

    .bb-result .bb-table-wrap {
        max-height: 85vh;
    }
</style>

<div class="bb-wrap">
    <div class="bb-grid">
        <div class="bb-banner">
            <img src="~/images/chem-report_banner.png" alt="CHEM report banner" />
        </div>

        <!-- LEFT (แถวเดียวกับ banner) -->
        <div class="bb-card bb-filter">
            <h2 class="bb-title">CHEM Receive Report</h2>

            <div class="bb-row">
                <div class="bb-field">
                    <label for="startDateText">Start Date</label>
                    <div class="bb-date">
                        <input id="startDateText" type="text" readonly data-date-for="startDate" />
                        <input id="startDate" type="date" class="bb-date-native" tabindex="-1" aria-hidden="true" value="@Model.DefaultStartYmd" />
                    </div>
                </div>

                <div class="bb-field">
                    <label for="endDateText">End Date</label>
                    <div class="bb-date">
                        <input id="endDateText" type="text" readonly data-date-for="endDate" />
                        <input id="endDate" type="date" class="bb-date-native" tabindex="-1" aria-hidden="true" value="@Model.DefaultEndYmd" />
                    </div>
                </div>

                <div class="bb-field">
                    <label>Product</label>
                    <select id="product">
                        <option value="">(All)</option>
                        @foreach (var it in Model.Products)
                        {
                            <option value="@it.Code">@it.Name</option>
                        }
                    </select>
                </div>

                <div class="bb-field">
                    <label>Company</label>
                    <select id="company">
                        <option value="">(All)</option>
                        @foreach (var it in Model.Companies)
                        {
                            <option value="@it.Code">@it.Name</option>
                        }
                    </select>
                </div>

                <div class="bb-actions">
                    <button type="button" class="bb-btn" id="btnLoad" data-bb-action>Load</button>
                    <button type="button" class="bb-btn secondary" id="btnExport" data-bb-action>Export CSV</button>
                </div>
                <div class="bb-actions" style="margin-top:0;">
                    <button type="button" class="bb-btn" id="btnExportF29" data-bb-action title="F-MS-HACCP-กผจ-29 REV04 — 1 sheet ต่อวัน × สาร">Export F-29 (Excel)</button>
                </div>

                <div class="bb-status" id="status">Ready.</div>
            </div>
        </div>

        <!-- RESULT (แถวล่าง เต็มความกว้าง) -->
        <div class="bb-card bb-result">
            <div class="bb-result-header">
                <h2 class="bb-title" style="margin:0;">Result</h2>
                <div class="bb-result-total" id="totalNet">Total NetWeight: -</div>
            </div>

            <div class="bb-summary" id="summary"></div>

            <div class="bb-table-wrap">
                <table class="bb-table" id="tbl">
                    <colgroup>
                        <col class="c-no" />
                        <col class="c-date" />
                        <col class="c-truck" />
                        <col class="c-comp" />
                        <col class="c-sg" />
                        <col class="c-temp" />
                        <col class="c-vol" />
                        <col class="c-tank" />
                        <col class="c-lv" />
                        <col class="c-in" />
                        <col class="c-out" />
                        <col class="c-net" />
                        <col class="c-alloc" />
                        <col class="c-bill" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="center">#</th>
                            <th>Date / Time</th>
                            <th>Truck</th>
                            <th>Company / Product</th>
                            <th class="num">SG</th>
                            <th class="num">Temp °C</th>
                            <th class="num">Vol m³</th>
                            <th class="center">Tank</th>
                            <th class="num">Level ก่อน → หลัง</th>
                            <th class="num">Gross In</th>
                            <th class="num">Gross Out</th>
                            <th class="num">Net (kg)</th>
                            <th class="num" title="น้ำหนักที่ปันส่วนเข้าถังตามปริมาตรที่เพิ่ม">เข้าถัง (t)</th>
                            <th>ใบนำส่ง</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        <tr><td colspan="14" style="color: rgba(232,238,252,.6);">No data.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
    const BACKEND_BASE_URL = "@(Model.BackendBaseUrl ?? "")";
    const CHEM_REPORT_PATH = "@(Model.ChemReportPath ?? "/api/chem_report")";
    const CHEM_EXPORT_PATH = "@(Model.ChemExportPath ?? "/api/chem_report/export")";

    function combineUrl(baseUrl, path) {
        baseUrl = (baseUrl || "").replace(/\/+$/, "");
        path = (path || "").trim();
        if (!path.startsWith("/")) path = "/" + path;
        return baseUrl + path;
    }

    function setStatus(msg) {
        document.getElementById("status").textContent = msg;
    }

    function setTotalNet(text) {
        document.getElementById("totalNet").textContent = `Total NetWeight: ${text} Kg.`;
    }

    function getSelectedTextOrAll(selId) {
        const sel = document.getElementById(selId);
        if (!sel) return "(All)";
        const opt = sel.options[sel.selectedIndex];
        const text = (opt ? opt.text : "").trim();
        return text ? text : "(All)";
    }

    function buildPayload() {
        const startDate = document.getElementById("startDate").value;
        const endDate = document.getElementById("endDate").value;

        const productCode = document.getElementById("product").value || "";
        const companyCode = document.getElementById("company").value || "";

        const productText = productCode ? getSelectedTextOrAll("product") : "(All)";
        const companyText = companyCode ? getSelectedTextOrAll("company") : "(All)";

        return { startDate, endDate, productCode, companyCode, productText, companyText };
    }

    function escapeHtml(s) {
        return (s ?? "").toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function parseNetWeight(v) {
        if (v === null || v === undefined) return 0;
        const s = String(v).replaceAll(",", "").trim();
        const n = Number(s);
        return isNaN(n) ? 0 : n;
    }

    function formatNumber(n) {
        return new Intl.NumberFormat("en-US").format(n);
    }

    // ===== วันที่: เก็บค่า yyyy-MM-dd ใน native input, แสดงผล d-MMM-yyyy (12-Oct-2026) =====
    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    function ymdToDisplay(ymd) {
        const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(ymd || ""));
        if (!m) return ymd || "";
        return `${Number(m[3])}-${MONTHS[Number(m[2]) - 1]}-${m[1]}`;
    }

    function syncDateText(nativeId) {
        const native = document.getElementById(nativeId);
        const text = document.querySelector(`[data-date-for="${nativeId}"]`);
        if (native && text) text.value = ymdToDisplay(native.value);
    }

    document.querySelectorAll("[data-date-for]").forEach(text => {
        const native = document.getElementById(text.dataset.dateFor);
        const open = () => {
            try { native.showPicker(); } catch { native.focus(); native.click(); }
        };
        text.addEventListener("click", open);
        text.addEventListener("keydown", e => {
            if (e.key === "Enter" || e.key === " " || e.key === "ArrowDown") { e.preventDefault(); open(); }
        });
        native.addEventListener("change", () => syncDateText(native.id));
        syncDateText(native.id);
    });

    function fmt(v, digits) {
        if (v === null || v === undefined || v === "") return "";
        const n = Number(v);
        return isNaN(n) ? escapeHtml(v) : n.toFixed(digits);
    }

    function tankLetter(tank) {
        const parts = String(tank || "").trim().split(/\s+/);
        return parts[parts.length - 1] || "";
    }

    function sideClass(side) {
        return side === "AB" ? "ab" : side === "CD" ? "cd" : "";
    }

    function renderSummary(summary) {
        const el = document.getElementById("summary");
        if (!summary || summary.length === 0) { el.innerHTML = ""; return; }

        el.innerHTML = summary.map(s => {
            const est = s.Estimated ? "≈" : "";
            const tip = s.Estimated ? ' title="มีเที่ยวที่ระดับถังไม่ครบ — ปันเท่ากันทุกถัง (ประมาณการ)"' : "";
            return `<div class="bb-chip ${sideClass(s.Side)}"${tip}>
                ${escapeHtml(s.Chemical)} ${escapeHtml(s.Label)}:
                <b>${est}${formatNumber(Number(s.Tonnes).toFixed(3))}</b> t
            </div>`;
        }).join("");
    }

    // รถเติมหลายถัง = 1 แถวต่อถัง แถวที่ 2+ แสดงเฉพาะข้อมูลถัง (เหมือนแบบฟอร์ม F-29)
    function renderRows(rows) {
        const tbody = document.getElementById("tbody");

        if (!rows || rows.length === 0) {
            tbody.innerHTML = `<tr><td colspan="14" style="color: rgba(232,238,252,.6);">No data.</td></tr>`;
            setTotalNet("-");
            return;
        }

        let total = 0;
        let html = "";

        for (const r of rows) {
            const net = parseNetWeight(r.NetWeight);
            total += net;

            const bill = [r.BillBook && r.BillBook !== "-" ? r.BillBook : "", r.BillNo || ""].filter(x => x).join("/");
            const fills = (r.Fills && r.Fills.length) ? r.Fills : [null];

            fills.forEach((f, i) => {
                const first = i === 0;
                const tankCell = f
                    ? `<span class="bb-tank ${sideClass(f.Side)}" title="${escapeHtml(f.Tank)}">${escapeHtml(tankLetter(f.Tank))}</span>${r.IsWash ? ' <span class="bb-muted">ล้าง</span>' : ""}`
                    : `<span class="bb-muted" title="ไม่มีบันทึกจาก Sidecar">-</span>`;
                const alloc = f
                    ? `${f.Estimated ? '<span title="ระดับถังไม่ครบ — ประมาณการ">≈</span>' : ""}${fmt(f.Tonnes, 3)}`
                    : "";
                const level = f && (f.LevelBefore != null || f.LevelAfter != null)
                    ? `${fmt(f.LevelBefore, 1) || "?"} → ${fmt(f.LevelAfter, 1) || "?"}`
                    : "";
                const t = (v) => first ? v : "";

                html += `<tr class="${first ? "trip-start" : "cont"}">
                    <td class="center">${t(escapeHtml(r.No))}</td>
                    <td>${t(`${escapeHtml(ymdToDisplay(r.Date))}<span class="bb-sub">${escapeHtml(r.Time)}</span>`)}</td>
                    <td>${t(escapeHtml(r.Truck))}</td>
                    <td title="${escapeHtml(r.Company)} · ${escapeHtml(r.Product)}">${t(`${escapeHtml(r.Company)}<span class="bb-sub">${escapeHtml(r.Product)}</span>`)}</td>
                    <td class="num">${t(fmt(r.SG, 2))}</td>
                    <td class="num">${t(fmt(r.TempC, 1))}</td>
                    <td class="num">${t(fmt(r.VolumeM3, 2))}</td>
                    <td class="center">${tankCell}</td>
                    <td class="num lv">${level}</td>
                    <td class="num">${t(escapeHtml(r.GrossIn))}</td>
                    <td class="num">${t(escapeHtml(r.GrossOut))}</td>
                    <td class="num">${t(escapeHtml(r.NetWeight))}</td>
                    <td class="num">${alloc}</td>
                    <td title="${escapeHtml(bill)}">${t(escapeHtml(bill))}</td>
                </tr>`;
            });
        }

        tbody.innerHTML = html;
        setTotalNet(formatNumber(total));
    }

    async function postJson(url, payload) {
        return fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });
    }

    document.getElementById("btnLoad").addEventListener("click", async () => {
        try {
            const payload = buildPayload();
            setStatus("Loading...");

            const url = combineUrl(BACKEND_BASE_URL, CHEM_REPORT_PATH);
            const res = await postJson(url, payload);

            if (!res.ok) {
                const txt = await res.text();
                setStatus("Error: " + txt);
                return;
            }

            const data = await res.json();
            if (!data || data.ok !== true) {
                setStatus("Error: invalid response");
                return;
            }

            const rows = data.rows || [];
            renderRows(rows);
            renderSummary(data.summary || []);
            setStatus(`OK. Rows = ${rows.length}`);
        } catch (e) {
            setStatus("Exception: " + (e?.message || e));
        }
    });

    document.getElementById("btnExport").addEventListener("click", () => exportFile("csv", "CHEM_receive.csv"));
    document.getElementById("btnExportF29").addEventListener("click", () => exportFile("xlsx", "F-29_CHEM.xlsx"));

    async function exportFile(format, defaultName) {
        try {
            const payload = { ...buildPayload(), format };
            setStatus(format === "xlsx" ? "Exporting F-29 (Excel)..." : "Exporting CSV...");

            const url = combineUrl(BACKEND_BASE_URL, CHEM_EXPORT_PATH);
            const res = await postJson(url, payload);

            if (!res.ok) {
                const txt = await res.text();
                let msg = txt;
                try { msg = JSON.parse(txt).error || txt; } catch { }
                setStatus("Error: " + msg);
                return;
            }

            const blob = await res.blob();

            let filename = defaultName;
            const cd = res.headers.get("Content-Disposition");
            if (cd) {
                const m = /filename="([^"]+)"/i.exec(cd);
                if (m && m[1]) filename = m[1];
            }

            const objUrl = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = objUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(objUrl);

            setStatus("Export done: " + filename);
        } catch (e) {
            setStatus("Exception: " + (e?.message || e));
        }
    }

    // ===== Bypass role enforcement =====
    (function applyBypassState(role) {
        const isObserver = role === 'observer';
        // Observer: disable all action buttons
        document.querySelectorAll('[data-bb-action]').forEach(btn => {
            btn.disabled = isObserver;
        });
        if (isObserver) {
            setStatus('[Bypass: Observer] ปุ่มทั้งหมดถูก disable');
        } else if (role) {
            setStatus('[Bypass: ' + role + '] เชื่อมต่อ Aquadat ถูกปิด');
        }
    })(window.__bypassRole || '');

    document.addEventListener('bb:bypass-changed', function(e) {
        const role = e.detail.role;
        const isObserver = role === 'observer';
        document.querySelectorAll('[data-bb-action]').forEach(btn => {
            btn.disabled = isObserver;
        });
        if (isObserver) {
            setStatus('[Bypass: Observer] ปุ่มทั้งหมดถูก disable');
        } else if (role) {
            setStatus('[Bypass: ' + role + '] เชื่อมต่อ Aquadat ถูกปิด');
        } else {
            setStatus('Ready.');
        }
    });
</script>
