@page
@model BellBeast.Pages.AlarmMonitorModel
@{
    ViewData["Title"] = "Alarm Monitor";
}

@section Styles {
<style>
    .am-wrap { width: min(1280px, 96%); margin: 0 auto; padding: 18px 0 28px; color: #e8eefc; }
    .am-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 14px; }
    .am-title { margin: 0; font-size: clamp(22px, 2.2vw, 30px); font-weight: 800; }
    .am-sub { font-size: 12px; color: rgba(148,163,184,.75); letter-spacing: .04em; }
    .am-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
    .am-chip { padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 700;
               border: 1px solid rgba(148,163,184,.25); background: rgba(15,23,42,.7); white-space: nowrap; }
    .am-chip.ok { border-color: #22c55e; color: #86efac; }
    .am-chip.warn { border-color: #f59e0b; color: #fcd34d; }
    .am-chip.bad { border-color: #ef4444; color: #fca5a5; }
    .am-chip.info { border-color: #38bdf8; color: #7dd3fc; }

    .am-card { border: 1px solid rgba(148,163,184,.16); border-radius: 16px; margin-bottom: 14px; overflow: hidden;
               background: linear-gradient(180deg, rgba(15,23,42,.82), rgba(15,23,42,.56)); box-shadow: 0 14px 36px rgba(0,0,0,.2); }
    .am-card h2 { margin: 0; padding: 12px 16px; font-size: 14px; font-weight: 700; letter-spacing: .04em;
                  color: rgba(226,232,240,.9); border-bottom: 1px solid rgba(148,163,184,.12); display: flex; gap: 10px; align-items: center; }
    .am-card h2 .am-spacer { flex: 1; }
    .am-card h2 select, .am-card h2 input { background: rgba(2,6,23,.6); color: #e2e8f0; border: 1px solid rgba(148,163,184,.25);
                  border-radius: 8px; padding: 3px 8px; font-size: 12px; }

    .am-active-empty { padding: 14px 16px; font-size: 13px; color: rgba(148,163,184,.8); }
    .am-active-item { display: grid; grid-template-columns: 10px 1fr auto; gap: 12px; align-items: center;
                      padding: 10px 16px; border-bottom: 1px solid rgba(148,163,184,.08); }
    .am-active-item:last-child { border-bottom: 0; }
    .am-active-item .t { font-weight: 700; font-size: 14px; }
    .am-active-item .m { font-size: 12px; color: rgba(148,163,184,.85); margin-top: 2px; }
    .am-active-item .v { font-size: 18px; font-weight: 800; font-variant-numeric: tabular-nums; }
    .am-active-item.cleared { opacity: .5; }

    .am-dot { width: 10px; height: 10px; border-radius: 50%; background: #64748b; display: inline-block; }
    .st-alerting { background: #ef4444; box-shadow: 0 0 8px #ef4444; }
    .st-near { background: #f59e0b; }
    .st-normal { background: #22c55e; }
    .st-not_ready, .st-fsnl, .st-stale, .st-no_data { background: #64748b; }

    .am-table-wrap { overflow-x: auto; }
    table.am { width: 100%; border-collapse: collapse; font-size: 13px; }
    table.am th { text-align: left; padding: 8px 12px; font-size: 11px; font-weight: 700; letter-spacing: .06em;
                  color: rgba(148,163,184,.8); text-transform: uppercase; border-bottom: 1px solid rgba(148,163,184,.14); white-space: nowrap; }
    table.am td { padding: 8px 12px; border-bottom: 1px solid rgba(148,163,184,.07); vertical-align: middle; }
    table.am tr.am-row { cursor: pointer; }
    table.am tr.am-row:hover { background: rgba(56,189,248,.07); }
    table.am tr.am-row.sel { background: rgba(56,189,248,.14); }
    td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    td.reason { color: rgba(148,163,184,.85); font-size: 12px; }
    .am-zbar { position: relative; width: 120px; height: 10px; border-radius: 5px; background: rgba(148,163,184,.18); }
    .am-zbar .band { position: absolute; top: 0; bottom: 0; background: rgba(34,197,94,.25); border-radius: 5px; }
    .am-zbar .mk { position: absolute; top: -3px; width: 4px; height: 16px; border-radius: 2px; background: #e2e8f0; transform: translateX(-2px); }
    .am-zbar.alert .mk { background: #ef4444; }
    .am-zbar.near .mk { background: #f59e0b; }

    .am-charts { display: grid; grid-template-columns: 1fr; gap: 0; padding: 10px 14px 14px; }
    .am-chartbox { position: relative; height: 260px; }
    .am-chartbox.small { height: 150px; margin-top: 8px; }
    .am-hint { padding: 20px 16px; font-size: 13px; color: rgba(148,163,184,.8); }
    .am-err { padding: 8px 16px; font-size: 12px; color: #fca5a5; display: none; }
</style>
}

<partial name="_AdminTabs" model='"alarm"' />

<div class="am-wrap">
    <div class="am-head">
        <div>
            <h1 class="am-title">Alarm Monitor</h1>
            <div class="am-sub">z-score ของแต่ละจุดเทียบ moving window · ข้อมูลจาก Uroboros alarm engine · ใช้ดูเหตุผลและปรับ k / sigma_floor</div>
        </div>
        <div class="am-chips">
            <span class="am-chip" id="chipMode">mode: –</span>
            <span class="am-chip" id="chipEngine">engine: –</span>
            <span class="am-chip" id="chipActive">active: –</span>
            <span class="am-chip" id="chipUpdated">–</span>
        </div>
    </div>
    <div class="am-err" id="amErr"></div>

    <section class="am-card">
        <h2>
            Alarm ที่กำลังแจ้ง
            <span class="am-spacer"></span>
            <label>zone <input id="zoneFilter" placeholder="ทั้งหมด เช่น RWS,DPS" size="18"></label>
        </h2>
        <div id="activeBox"><div class="am-active-empty">กำลังโหลด…</div></div>
    </section>

    <section class="am-card">
        <h2>
            ทุกจุดที่ตรวจ
            <span class="am-spacer"></span>
            <label>แสดง
                <select id="kindFilter">
                    <option value="">ทั้งหมด</option>
                    <option value="anomaly">anomaly (flow)</option>
                    <option value="threshold">threshold</option>
                </select>
            </label>
        </h2>
        <div class="am-table-wrap">
            <table class="am">
                <thead>
                    <tr>
                        <th></th><th>จุด</th><th>zone</th><th>ชนิด</th>
                        <th style="text-align:right">ค่าล่าสุด</th>
                        <th style="text-align:right">z</th>
                        <th>ตำแหน่ง z (−k … +k)</th>
                        <th>สถานะ</th><th>เหตุผล</th>
                    </tr>
                </thead>
                <tbody id="ruleRows"></tbody>
            </table>
        </div>
    </section>

    <section class="am-card">
        <h2 id="chartTitle">กราฟ — เลือกจุดจากตารางด้านบน</h2>
        <div id="chartHint" class="am-hint">คลิกแถวในตารางเพื่อดูกราฟค่า, แถบ ±kσ และ z ย้อนหลัง</div>
        <div class="am-charts" id="chartBox" style="display:none">
            <div class="am-chartbox"><canvas id="valChart"></canvas></div>
            <div class="am-chartbox small" id="zBox"><canvas id="zChart"></canvas></div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/alarmmonitor.js" asp-append-version="true"></script>
}
