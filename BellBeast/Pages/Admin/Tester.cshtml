@page
@model BellBeast.Pages.Admin.TesterModel
@{
    ViewData["Title"] = "Tester";
    ViewData["ContentClass"] = "content content-admin";
}

@section Styles {
<style>
    .ts-wrap { width: 90%; margin: 0 auto; display: flex; flex-direction: column; }
    .ts-bar { display: flex; align-items: center; gap: 12px; margin: 0 0 8px; color: #94a3b8; font-size: 13px; }
    .ts-bar .sp { flex: 1; }
    .ts-bar a { color: #5cb8f0; text-decoration: none; }
    .ts-bar a:hover { text-decoration: underline; }
    .ts-frame {
        width: 100%;
        height: calc(100vh - 210px);
        min-height: 560px;
        border: 1px solid rgba(148,163,184,.2);
        border-radius: 12px;
        background: #0d1117;
    }
</style>
}

<partial name="_AdminTabs" model='"tester"' />

<div class="ts-wrap">
    <div class="ts-bar">
        <span>BellBeast Tester — ทดสอบ Fullscale_V3 ตาม handoff1311 · request ทั้งหมดยิงจาก tester โดยไม่มี cookie admin</span>
        <span class="sp"></span>
        <a href="/tester" target="_blank" rel="noopener">เปิดเต็มจอ ↗</a>
    </div>
    <iframe class="ts-frame" src="/tester" title="BellBeast Tester"></iframe>
</div>
