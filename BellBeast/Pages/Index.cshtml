@page
@model IndexModel
@{
    ViewData["Title"] = "AQ Table";
    ViewData["ContentClass"] = "content content-aq"; // กว้างเกือบเต็มจอ คงที่ (site.css)
}

@section Styles {
    <style>
        /* หัวคอลัมน์ "เลือกทั้งหมด" ในตารางผลลัพธ์ */
        #tbl th.col-check { width: 92px; }
        .chk-all { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; white-space: nowrap; }
        .chk-all input { cursor: pointer; }

        /* รายการที่เลือก: แสดงครั้งละ 10 แถว + เปลี่ยนหน้า (ไม่ต้อง scroll) */
        .table-wrap.small.sel-paged { max-height: none; overflow-y: visible; }
        .sel-pager { margin-top: 10px; }
        .sel-count { color: var(--muted); font-weight: 700; }

        /* ===== signed-in badge (name + position from the ADFS token) ===== */
        .toolbar-right { display: inline-flex; align-items: center; gap: 12px; }

        .user-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            max-width: 280px;
            padding: 6px 12px 6px 6px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: var(--card2);
        }

        .user-badge-avatar {
            flex: 0 0 auto;
            width: 30px; height: 30px;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            color: #eff6ff;
            font-weight: 800; font-size: 14px;
        }

        .user-badge-text { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }

        .user-badge-name {
            color: var(--text); font-weight: 700; font-size: 13px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .user-badge-pos {
            color: var(--muted); font-size: 11px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        /* bypass / test-account badge — amber, visually distinct from a real AD login */
        .user-badge-bypass {
            border-color: rgba(245, 158, 11, 0.45);
            background: rgba(245, 158, 11, 0.12);
        }
        .user-badge-bypass .user-badge-avatar {
            background: linear-gradient(135deg, #d97706, #f59e0b);
            color: #1f1300;
        }
        .user-badge-bypass .user-badge-name { color: #fcd34d; }
        .user-badge-bypass .user-badge-pos { color: #fbbf24; }

        @@media (max-width: 640px) {
            .user-badge-text { display: none; }
            .user-badge { padding: 5px; }
        }

        /* ===== logout confirm modal ===== */
        .bb-modal-overlay {
            position: fixed; inset: 0; z-index: 1000;
            display: flex; align-items: center; justify-content: center;
            padding: 20px;
            background: rgba(2, 6, 23, 0.62);
            backdrop-filter: blur(4px);
            animation: bbFade 0.14s ease;
        }
        .bb-modal-overlay[hidden] { display: none; }

        .bb-modal {
            width: 100%; max-width: 380px;
            padding: 26px 24px 20px;
            border-radius: 18px;
            border: 1px solid var(--line);
            background: linear-gradient(180deg, rgba(17, 24, 39, 0.98), rgba(15, 23, 42, 0.96));
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
            text-align: center;
            animation: bbPop 0.16s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .bb-modal-icon {
            width: 52px; height: 52px; margin: 0 auto 14px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 50%;
            background: rgba(248, 113, 113, 0.14);
            color: #f87171;
        }

        .bb-modal-title { margin: 0 0 8px; color: var(--text); font-size: 19px; font-weight: 800; }
        .bb-modal-text { margin: 0 0 22px; color: var(--muted); font-size: 14px; line-height: 1.6; }

        .bb-modal-actions { display: flex; gap: 10px; justify-content: center; }
        .bb-modal-actions .btn { min-width: 120px; }

        .bb-btn-danger {
            background: linear-gradient(135deg, #dc2626, #ef4444);
            color: #fff; border: 0;
        }
        .bb-btn-danger:hover { filter: brightness(1.06); }

        @@keyframes bbFade { from { opacity: 0; } to { opacity: 1; } }
        @@keyframes bbPop { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }
    </style>
}

<div class="card">
    <div class="toolbar">
        <div class="toolbar-left">
            <div id="status" class="status">ผลลัพธ์ (- แถว)</div>
        </div>

        <!-- ✅ ลบปุ่มเพิ่มเข้าจาก toolbar ออก (กันซ้ำ id + ให้ไปอยู่แถว keyword ตามรูป 2) -->
        <div class="toolbar-right">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                var displayName = User.FindFirst("DisplayName")?.Value;
                if (string.IsNullOrWhiteSpace(displayName)) displayName = User.Identity?.Name ?? "";
                var position = User.FindFirst("Position")?.Value ?? "";
                var isBypass = string.Equals(User.FindFirst("LoginKind")?.Value, "bypass", StringComparison.OrdinalIgnoreCase);
                var initial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[..1].ToUpperInvariant();
                <div class="user-badge@(isBypass ? " user-badge-bypass" : "")" title="@displayName@(string.IsNullOrWhiteSpace(position) ? "" : " · " + position)">
                    <span class="user-badge-avatar" aria-hidden="true">@(isBypass ? "⚙" : initial)</span>
                    <span class="user-badge-text">
                        <span class="user-badge-name">@displayName</span>
                        @if (!string.IsNullOrWhiteSpace(position))
                        {
                            <span class="user-badge-pos">@position</span>
                        }
                    </span>
                </div>
            }
            <button id="btnLogout" class="btn btn-secondary" type="button">Logout</button>
        </div>
    </div>

    <!-- Logout confirm dialog (replaces the browser confirm() popup) -->
    <div id="logoutModal" class="bb-modal-overlay" hidden>
        <div class="bb-modal" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle">
            <div class="bb-modal-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>
            <h3 id="logoutModalTitle" class="bb-modal-title">ออกจากระบบ</h3>
            <p class="bb-modal-text">ต้องการออกจากระบบใช่หรือไม่? คุณจะต้องเข้าสู่ระบบด้วยบัญชี AD อีกครั้ง</p>
            <div class="bb-modal-actions">
                <button type="button" class="btn btn-secondary" id="logoutCancel">ยกเลิก</button>
                <button type="button" class="btn bb-btn-danger" id="logoutConfirm">ออกจากระบบ</button>
            </div>
        </div>
    </div>

    <div class="filters">
        <div class="filters-grid">

            <!-- Plant block -->
            <div class="filter-card">
                <div class="filter-title">โรงงาน (Plant)</div>
                <div class="plant-row">
                    <select id="plantSelect" class="input plant-select" aria-label="เลือกโรงงาน">
                        <!-- JS จะเติมตัวเลือกให้ -->
                    </select>
                    <div class="plant-fullname" id="plantFullName"></div>
                </div>
            </div>

            <!-- Station block -->
            <div class="filter-card">
                <div class="filter-title">สถานี (Station – toggle)</div>
                <div class="switch-row" id="stationSwitches">
                    <!-- JS จะเติม toggle ให้ -->
                </div>
            </div>

            <!-- Keyword block (เต็มแถว) -->
            <div class="filter-card span-2">
                <div class="filter-title">คำค้น (เช่น Turbidity, RWS, Flow, 191)</div>

                <!-- ✅ แถวเดียวแบบรูป 2 -->
                <div class="kw-row">
                    <input id="q" class="input kw-input"
                           placeholder="พิมพ์ชื่อพารามิเตอร์ / สถานี / plant / equipment / หน่วย หรือ configID..." />

                    <button id="btnReset" class="btn btn-secondary kw-reset" type="button">Reset</button>

                    <div id="statusInline" class="status-inline">ผลลัพธ์ (- แถว)</div>

                    <!-- ✅ ปุ่มเพิ่มเข้าอยู่แถวเดียวกับ Reset -->
                    <!-- ✅ id ไม่ซ้ำแล้ว -->
                    <button id="btnAddSelected" class="btn btn-success kw-add" type="button" disabled>
                        เพิ่มเข้า “รายการที่เลือก” (<span id="selectedCount">0</span>)
                    </button>
                </div>
            </div>

        </div>
    </div>

    <div class="table-wrap">
        <table id="tbl" class="aq-table">
            <thead>
                <tr>
                    <th class="col-check">
                        <label class="chk-all" title="เลือก/ยกเลิกทุกแถวในหน้านี้">
                            <input type="checkbox" id="chkAll" /> ทั้งหมด
                        </label>
                    </th>
                    <th class="col-id">configID</th>
                    <th class="col-plant">Plant</th>
                    <th class="col-station">Station</th>
                    <th class="col-param">Param</th>
                    <th class="col-equip">Equipment</th>
                    <th class="col-measure">Measure (TH)</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="pager">
        <button id="btnPrev" class="btn" type="button">Prev</button>
        <div id="pageInfo" class="pageinfo">Page -</div>
        <button id="btnNext" class="btn" type="button">Next</button>
    </div>

    <div class="selected">
        <div class="selected-bar">
            <div class="selected-title">รายการที่เลือก <span class="sel-count">(<span id="selTotal">0</span>)</span></div>

            <div class="selected-actions">
                <button id="btnSaveTemplate" class="btn btn-success" type="button">
                    Save template
                </button>

                <button id="btnLoadTemplate" class="btn-orange">
                    Load template
                </button>

                <!-- file picker ซ่อนไว้ -->
                <input id="fileTemplate" type="file" accept=".json,application/json" style="display:none" />
            </div>
        </div>

        <div class="table-wrap small sel-paged">
            <table id="tblSelected" class="aq-table">
                <thead>
                    <tr>
                        <th class="col-check">ลบ</th>
                        <th class="col-id">configID</th>
                        <th class="col-plant">Plant</th>
                        <th class="col-station">Station</th>
                        <th class="col-param">Param</th>
                        <th class="col-equip">Equipment</th>
                        <th class="col-measure">Measure (TH)</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="pager sel-pager">
            <button id="btnSelPrev" class="btn" type="button">Prev</button>
            <div id="selPageInfo" class="pageinfo">Page 1 / 1</div>
            <button id="btnSelNext" class="btn" type="button">Next</button>
        </div>
    </div>

    <div class="selected-head">
        <div class="selected-actions">
           

            <div class="date-box">
                <label>Begin</label>
                <input id="beginDate" type="date" class="input date-input" />
            </div>

            <div class="date-box">
                <label>End</label>
                <input id="endDate" type="date" class="input date-input" />
            </div>

            <button id="btnProceed" class="btn-green" data-bb-action>Proceed Query</button>
            <button id="btnClearSelected" class="btn btn-danger">Clear All Selection</button>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
