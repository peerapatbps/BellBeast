@page
@model BellBeast.Pages.DailyReportModel
@{
    ViewData["Title"] = "Daily Report";
    ViewData["ContentClass"] = "content content-wide";
}

<style>
    .dr-wrap { width: 100%; max-width: none; margin: 0; padding: 16px 10%; box-sizing: border-box; }
    .dr-grid { display: grid; grid-template-columns: 330px minmax(0, 1fr); gap: 14px; align-items: stretch; }
    .dr-grid > .dr-result { grid-column: 1 / -1; }
    @@media (max-width: 900px) {
        .dr-wrap { padding: 16px; }
        .dr-grid { grid-template-columns: 1fr; }
    }

    .dr-card {
        background: rgba(20, 25, 35, .72);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: 14px;
        color: #e8eefc;
        min-width: 0;
    }
    .dr-title { font-size: 20px; font-weight: 700; margin: 0 0 10px 0; color: #e8eefc; }
    .dr-label { display: block; font-size: 13px; color: rgba(232,238,252,.8); margin: 10px 0 6px; }
    .dr-check { display: flex; align-items: center; gap: 8px; font-size: 14px; margin: 4px 0; cursor: pointer; }
    .dr-check.sub { margin-left: 22px; font-size: 13px; color: rgba(232,238,252,.75); }

    .dr-date { position: relative; margin-bottom: 8px; }
    .dr-date input[type="text"] {
        width: 100%; box-sizing: border-box; padding: 10px 34px 10px 11px; font-size: 15px;
        border-radius: 10px; border: 1px solid rgba(255,255,255,.12); background: rgba(0,0,0,.25);
        color: #e8eefc; outline: none; cursor: pointer;
    }
    .dr-date::after { content: "📅"; position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 14px; opacity: .8; pointer-events: none; }
    .dr-date-native { position: absolute; left: 0; bottom: 0; width: 100%; height: 0; padding: 0 !important; border: 0 !important; opacity: 0; pointer-events: none; }

    /* ===== left box: header + bigger text ===== */
    .dr-head {
        display: flex; align-items: center; gap: 12px;
        margin: -14px -14px 14px; padding: 16px 14px 14px;
        background: linear-gradient(135deg, rgba(50,170,255,.22), rgba(120,90,255,.14) 60%, rgba(0,0,0,0));
        border-bottom: 1px solid rgba(120,180,255,.25);
        border-radius: 14px 14px 0 0;
    }
    .dr-head-icon {
        flex: 0 0 auto; width: 46px; height: 46px; border-radius: 12px;
        display: grid; place-items: center; font-size: 24px;
        background: rgba(50,170,255,.22); border: 1px solid rgba(120,190,255,.45);
        box-shadow: 0 0 18px rgba(50,170,255,.25);
    }
    .dr-head-title {
        margin: 0; font-size: 25px; font-weight: 800; letter-spacing: .4px; line-height: 1.1;
        background: linear-gradient(90deg, #ffffff, #9fd4ff);
        -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .dr-head-sub { margin-top: 4px; font-size: 13px; color: rgba(190,220,255,.75); letter-spacing: .3px; }
    .dr-filter .dr-label { font-size: 15px; font-weight: 600; margin: 14px 0 8px; }
    .dr-filter .dr-check { font-size: 17px; margin: 7px 0; }
    .dr-filter .dr-check input { width: 18px; height: 18px; }
    .dr-filter .dr-check.sub { font-size: 15px; }
    .dr-filter .dr-date input[type="text"] { font-size: 18px; padding: 12px 38px 12px 13px; }
    .dr-filter .dr-date::after { font-size: 17px; }
    .dr-range-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); align-items: center; margin: 14px 0 8px; }
    .dr-range-head .dr-label { margin: 0; }
    .dr-btn.dr-clear { width: 100%; padding: 6px 2px; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dr-filter .dr-status { font-size: 15px; }
    .dr-filter .dr-note { font-size: 14px; }
    .dr-btn {
        padding: 10px 13px; border-radius: 10px; border: 1px solid rgba(255,255,255,.12);
        background: rgba(80,110,255,.18); color: #e8eefc; cursor: pointer; font-size: 15px;
    }
    .dr-btn:hover { background: rgba(80,110,255,.28); }
    .dr-btn:disabled { opacity: .5; cursor: progress; }
    .dr-btn.secondary { background: rgba(255,255,255,.08); }
    .dr-btn.secondary:hover { background: rgba(255,255,255,.12); }
    .dr-btn.small { padding: 4px 9px; font-size: 12px; border-radius: 8px; }
    .dr-btn.block { width: 100%; margin-top: 8px; }
    .dr-btn.primary { background: rgba(50,170,255,.32); border-color: rgba(50,170,255,.6); }
    .dr-btn.primary:hover { background: rgba(50,170,255,.42); }

    .dr-status { margin-top: 10px; font-size: 13px; color: rgba(232,238,252,.75); white-space: pre-wrap; }
    .dr-note { margin-top: 8px; font-size: 12px; color: rgba(255,200,90,.9); }

    .dr-conn { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); white-space: nowrap; }
    .dr-conn[hidden] { display: none; }

    .pill { display: inline-block; font-size: 12px; padding: 2px 8px; border-radius: 8px; white-space: nowrap; border: 1px solid transparent; }
    .st-ok   { background: rgba(70,200,120,.18);  border-color: rgba(70,200,120,.45);  color: #b6f0c9; }
    .st-warn { background: rgba(255,180,60,.16);  border-color: rgba(255,180,60,.45);  color: #ffd99a; }
    .st-live { background: rgba(80,160,255,.18);  border-color: rgba(80,160,255,.5);   color: #bcdcff; }
    .st-no   { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.12); color: rgba(232,238,252,.5); }
    .st-err  { background: rgba(255,80,80,.18);   border-color: rgba(255,80,80,.45);   color: #ffb3b3; }

    .dr-cal-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
    .dr-cal-nav { display: flex; align-items: center; gap: 8px; }
    .dr-cal-month { font-size: 17px; font-weight: 700; min-width: 150px; text-align: center; }
    .dr-legend { display: flex; gap: 6px; flex-wrap: wrap; }
    .dr-cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
    .dr-cal .dow { text-align: center; font-size: 12px; color: rgba(232,238,252,.5); padding-bottom: 2px; }
    .dr-day {
        height: 54px; border-radius: 10px; cursor: pointer; display: flex; flex-direction: column;
        align-items: center; justify-content: center; gap: 2px; font-size: 15px; font-weight: 700;
        border: 1px solid transparent; user-select: none; position: relative;
    }
    .dr-day small { font-size: 10px; font-weight: 400; opacity: .85; }
    .dr-day.future { opacity: .25; cursor: default; }
    .dr-day.in-range { outline: 2px solid rgba(255,255,255,.7); outline-offset: -2px; }
    .dr-day.today::after { content: ""; position: absolute; top: 5px; right: 6px; width: 6px; height: 6px; border-radius: 50%; background: #7cc4ff; }

    .dr-result-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
    .dr-summary { font-size: 14px; color: rgba(232,238,252,.85); }
    .dr-table-wrap { width: 100%; overflow-y: auto; max-height: 70vh; }
    table.dr-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .dr-table th, .dr-table td { border-bottom: 1px solid rgba(255,255,255,.08); padding: 8px 7px; font-size: 13px; text-align: left; vertical-align: middle; overflow-wrap: anywhere; }
    .dr-table th { position: sticky; top: 0; background: rgba(20,25,35,.95); z-index: 2; color: rgba(232,238,252,.75); font-weight: 600; }
    .dr-table tr.unchecked td { opacity: .55; }
    .dr-table .muted { color: rgba(232,238,252,.45); }
    .dr-table .sub { display: block; font-size: 11px; color: rgba(232,238,252,.5); margin-top: 2px; }
    .dr-table a { color: #9fd0ff; }
    .dr-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .dr-print { min-width: 80px; padding: 9px 16px; font-size: 15px; font-weight: 700; border-radius: 10px; }
    .dr-cal { touch-action: none; }
    .dr-remark { color: #ffd99a; font-size: 13px; }
</style>

<div class="dr-wrap">
    <div class="dr-grid">

        <!-- LEFT: filter -->
        <div class="dr-card dr-filter">
            <div class="dr-head">
                <div class="dr-head-icon" aria-hidden="true">📊</div>
                <div>
                    <h2 class="dr-head-title">Daily Report</h2>
                    <div class="dr-head-sub">MH_report · DailyLab</div>
                </div>
            </div>

            <span class="dr-label">รายงาน</span>
            <label class="dr-check"><input type="checkbox" id="optMh" checked /> MH_report (รายงานการผลิตน้ำ)</label>
            <label class="dr-check"><input type="checkbox" id="optLab" checked /> DailyLab</label>
            <label class="dr-check sub" title="ใส่ค่า Daily Dosage (Alum / PACl / Pre-Cl / Post-Cl) ลงชีท DailyLab">
                <input type="checkbox" id="optDosage" checked /> รวม Daily Dosage
            </label>

            <div class="dr-range-head">
                <span class="dr-label">ช่วงวันที่</span>
                <button type="button" class="dr-btn secondary dr-clear" id="btnClear" title="ล้างการเลือก แสดงทั้งเดือนในปฏิทิน">Clear select</button>
            </div>
            <div class="dr-date">
                <input id="fromText" type="text" readonly data-date-for="fromDate" aria-label="วันที่เริ่ม" />
                <input id="fromDate" type="date" class="dr-date-native" tabindex="-1" aria-hidden="true" value="@Model.DefaultStartYmd" />
            </div>
            <div class="dr-date">
                <input id="toText" type="text" readonly data-date-for="toDate" aria-label="วันที่สิ้นสุด" />
                <input id="toDate" type="date" class="dr-date-native" tabindex="-1" aria-hidden="true" value="@Model.DefaultEndYmd" />
            </div>

            <div class="dr-status" id="status">Ready.</div>
            <div class="dr-note" id="note" hidden></div>
        </div>

        <!-- RIGHT: calendar -->
        <div class="dr-card dr-calendar">
            <div class="dr-cal-head">
                <div class="dr-cal-nav">
                    <button type="button" class="dr-btn secondary small" id="calPrev" aria-label="เดือนก่อน">‹</button>
                    <span class="dr-cal-month" id="calMonth">-</span>
                    <button type="button" class="dr-btn secondary small" id="calNext" aria-label="เดือนถัดไป">›</button>
                </div>
                <div class="dr-legend">
                    <span class="pill st-ok">ครบ</span>
                    <span class="pill st-warn">ไม่ครบ</span>
                    <span class="pill st-live" title="วันนี้/เมื่อวาน ที่ยังไม่ได้กด SAVE DB ที่หน้า DAILY ของ LabVenture — ยังโหลด MH_report ไม่ได้">รอ SAVE DB</span>
                    <span class="pill st-no">ไม่มีข้อมูล</span>
                </div>
                <span class="dr-conn st-err" id="conn" hidden></span>
            </div>
            <div class="dr-cal" id="cal"></div>
        </div>

        <!-- BOTTOM: per-day table -->
        <div class="dr-card dr-result">
            <div class="dr-result-head">
                <h2 class="dr-title" style="margin:0;">ผลลัพธ์</h2>
                <button type="button" class="dr-btn primary" id="btnTable"
                        title="ข้อมูลดิบทั้งช่วงวันที่ (ไม่ลงฟอร์ม): แถว = วันที่/เวลา, คอลัมน์ = ค่า — ตามรายงานที่ติ๊กไว้ทางซ้าย">
                    ⬇ Download table
                </button>
            </div>
            <div class="dr-table-wrap">
                <table class="dr-table">
                    <colgroup>
                        <col style="width:9%" />
                        <col style="width:16%" />
                        <col style="width:17%" />
                        <col style="width:12%" />
                        <col style="width:27%" />
                        <col style="width:19%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>วันที่</th>
                            <th>ผู้จัดทำ / ผู้ทบทวน</th>
                            <th>MH_report</th>
                            <th>DailyLab</th>
                            <th>Excel Printout</th>
                            <th>หมายเหตุ</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        <tr><td colspan="6" class="muted">กำลังโหลด…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/dailyreport.js" asp-append-version="true"></script>
}
