{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bellbeast",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "BellBeast/BellBeast.csproj",
        "--no-launch-profile",
        "--",
        "--Kestrel:Endpoints:Http:Url=http://localhost:5077"
      ],
      "port": 5077
    },
    {
      "name": "bellbeast-tester",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../BellBeast_Tester", "run", "dev"],
      "port": 8890
    }
  ]
}